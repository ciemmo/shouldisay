// prisma/schema.prisma
// Database schema for ShouldISay tone analysis app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  analyses      Analysis[]
  subscription  Subscription?
  usage         UsageStats?
  accounts      Account[]
  sessions      Session[]
}

model Analysis {
  id              String   @id @default(cuid())
  userId          String
  inputText       String   @db.Text
  inputHash       String   // For deduplication

  // Core results
  verdict         Verdict  // OK, CAUTION, NOT_OK
  confidence      Float    // 0-1

  // Detailed results (JSON)
  severity        Json     // { level: 1-5, label: string }
  categories      Json     // Array of { category: string, score: float }
  feedback        Json     // { explanation: string, suggestions: string[] }
  contextAnalysis Json?    // Conversation flow analysis

  // Metadata
  modelVersion    String
  processingTime  Int      // ms
  charCount       Int
  isConversation  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([inputHash])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(FREE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageStats {
  id                String   @id @default(cuid())
  userId            String   @unique
  analysesThisMonth Int      @default(0)
  charsThisMonth    Int      @default(0)
  lastResetDate     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Verdict {
  OK
  CAUTION
  NOT_OK
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}